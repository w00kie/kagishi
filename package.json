{
  "name": "kagishi",
  "version": "0.1.0",
  "description": "A Bun-powered CLI for generating structured, provider-style API tokens.",
  "type": "module",
  "license": "MIT",
  "preferGlobal": true,
  "bin": {
    "kagishi": "./src/cli.ts"
  },
  "exports": {
    "./token": "./src/lib/token.ts",
    "./format": "./src/lib/format.ts"
  },
  "files": ["src", "README.md", "LICENSE", "tsconfig.json"],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "check": "biome check . && bun test",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "husky": "^9.1.7"
  },
  "keywords": ["bun", "cli", "token", "api-key", "secret", "security"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
